@dp.message(F.text.contains("http"))
async def handle_link(message: types.Message):
    await message.answer("iltimos! Biroz kutib turing\nVideoyingiz 4k sifatda yuklanmoqda")
    video_path = f"v_{message.from_user.id}.mp4"
    try:
        await asyncio.to_thread(download_video, message.text, video_path)
        if os.path.exists(video_path):
            await message.answer_video(video=types.FSInputFile(video_path), caption="Tayyor! ✅")
    except:
        await message.answer("Xatolik yuz berdi.")
    finally:
        if os.path.exists(video_path): os.remove(video_path)

@dp.message(F.text)
async def name_logic(message: types.Message):
    name = message.text.lower().strip()
    manosi = ISMLAR_MANOSI.get(name, "Bu ism o'zbek xalqi orasida juda mashhur va go'zal ism hisoblanadi.")
    
    poem = ""
    temp_name = name.replace("sh", "1").replace("ch", "2").replace("o'", "3")
    for letter in temp_name:
        key = "sh" if letter == "1" else "ch" if letter == "2" else "o'" if letter == "3" else letter
        if key in SHER_LUGATI:
            poem += f"**{key.upper()}** - {SHER_LUGATI[key]}\n"

    result = f"✨ **{message.text.capitalize()}** ismining ma'nosi:\n{manosi}\n\n📜 **Siz uchun maxsus sher:**\n\n{poem}"
    await message.answer(result, parse_mode="Markdown")


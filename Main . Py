YDL_OPTS = {'format': 'bestvideo+bestaudio/best', 'quiet': True, 'concurrent_fragments': 15}

def download_video(url, out_file):
    opts = YDL_OPTS.copy()
    opts['outtmpl'] = out_file
    with yt_dlp.YoutubeDL(opts) as ydl:
        ydl.download([url])

